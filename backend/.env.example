# Variables d'environnement du backend (toutes optionnelles en local).
# En local, copiez ce fichier en « .env » (même dossier) : il est chargé automatiquement au démarrage
# et n'est jamais envoyé sur GitHub. Sur Render, saisissez-les dans l'onglet Environment.

# Base de données (SQLite par défaut) et suivi MLflow
DATABASE_URL=sqlite:///./driftguard.db
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
# MLFLOW_ARTIFACT_ROOT=./mlruns
# DATASET_UPLOAD_DIR=./data/uploads

# Sécurité (OBLIGATOIRES en déploiement)
SECRET_KEY=une-longue-chaine-aleatoire
ADMIN_SIGNUP_CODE=code-d-invitation-pour-creer-un-compte-admin
CORS_ORIGINS=http://localhost:5173

# Démarrage automatique (utile quand le disque est effacé à chaque redémarrage)
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=mot-de-passe-solide
ADMIN_NAME=Administrateur
DEMO_USER_EMAIL=demo@exemple.com
DEMO_USER_PASSWORD=mot-de-passe-demo
SEED_DEMO=true

# Alertes par e-mail (optionnel).
# Mode 1 (GRATUIT, recommandé) : Resend, API HTTPS (fonctionne sur Render gratuit).
#   Créez un compte sur resend.com AVEC L'ADRESSE E-MAIL DE L'ADMINISTRATEUR, puis une clé API.
#   Sans domaine vérifié, les e-mails ne sont délivrés qu'à l'adresse du compte Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM=                                  # laisser vide : « DriftGuard <onboarding@resend.dev> »
# Mode 2 : Brevo, API HTTPS (demande parfois un paiement)
# EMAIL_FROM=alertes@votre-domaine.com        # adresse expéditrice validée chez Brevo
# BREVO_API_KEY=xkeysib-...
# Mode 3 : SMTP classique (bloqué sur Render gratuit)
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# FRONTEND_URL=http://localhost:5173           # lien dans les e-mails
# ALERT_EXTRA_RECIPIENTS=autre@exemple.com     # destinataires en plus des administrateurs
